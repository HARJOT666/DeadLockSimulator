# Backend environment (export these, or use your IDE's run configuration). LOCAL DEVELOPMENT VALUES.
DB_URL=jdbc:postgresql://localhost:5432/deadlock_simulator
DB_USERNAME=user1
DB_PASSWORD=user1
# Base64 HMAC key, >= 32 bytes. Generate one with:  openssl rand -base64 32
# If unset, the backend uses an ephemeral random key (all tokens invalid after restart).
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120
# true behind HTTPS
JWT_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Integration tests only
TEST_DB_URL=jdbc:postgresql://localhost:5432/deadlock_simulator_test
